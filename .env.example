# Example only. Generate your private .env with:
# python3 scripts/configure_solo.py --address YOUR_PUBLIC_IP_OR_DOMAIN --profile auto
# Never commit .env, credentials, runtime databases or exported account files.
# One site password; no separate users or workspace passwords in solo mode.
APP_MODE=solo
ADMIN_PASSWORD_HASH='REPLACE_WITH_GENERATED_SCRYPT_HASH'
MANAGEMENT_PASSWORD_HASH=
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
DOMAIN=localhost
WORKER_IMAGE=claude-cloud-worker:local
LOGIN_BROWSER_IMAGE=claude-cloud-login-browser:local
CLAUDE_VERSION=stable
# 8 GB profile. The configure_solo script detects 8/12/24 GB automatically.
WORKSPACE_MEMORY=1536m
WORKSPACE_CPUS=1
MAX_WORKSPACES=20
MAX_RUNNING_WORKSPACES=3
